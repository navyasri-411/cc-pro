# Local mode works without AWS. Set true only after configuring AWS.
AWS_ENABLED=false
AWS_REGION=ap-south-1
S3_BUCKET=your-private-bucket-name
DYNAMODB_TABLE=ecg-analysis-results
# Comma-separated allowed frontend origins; update for production.
# Local Vite dev servers commonly run on either localhost or 127.0.0.1.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=10
